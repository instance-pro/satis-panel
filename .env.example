# Values for docker compose, interpolated into docker-compose.yaml. Copy to .env for local
# testing (together with a docker-compose.override.yml that publishes a port). In Coolify
# set these in the UI instead. The Symfony defaults live in .env.dist.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
BUILD_TIMEOUT=1800
# Redis password for the webhook log and build queue. Coolify generates it, locally pick any value.
SERVICE_PASSWORD_REDIS=change-me-redis
