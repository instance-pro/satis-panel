# Values for docker compose, interpolated into docker-compose.yml. Copy to .env for local
# testing (together with a docker-compose.override.yml that publishes a port). In Coolify
# set these in the UI instead. The Symfony defaults live in .env.dist.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
WEBHOOK_SECRET=
APP_SECRET=
SATIS_HOMEPAGE=https://satis.example.com
SATIS_REPOSITORY_NAME=acme/satis
SATIS_AUTH_DISABLED=0
SSH_PRIVATE_KEY=
SSH_KEYSCAN_HOSTS=
COMPOSER_AUTH=
APP_ENV=prod
APP_DEBUG=0
