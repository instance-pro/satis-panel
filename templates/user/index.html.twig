{% extends 'layout.html.twig' %}

{% block title %}Composer access · {{ app_name }}{% endblock %}
{% block heading %}Composer access{% endblock %}

{% block content %}
{% if auth_disabled %}
    <div class="flash-warning mb-6">SATIS_AUTH_DISABLED is set, the package files are served without authentication. These users are ignored until it is unset.</div>
{% endif %}
<div class="grid gap-6 lg:grid-cols-3">
    <div class="card lg:col-span-2">
        <p class="mb-4 text-sm text-fg-muted">These accounts protect <span class="code">packages.json</span>, the package metadata and the dist archives (HTTP basic auth, stored as bcrypt in <span class="code">{{ htpasswd_path }}</span>). The passwords are also kept in <span class="code">composer-users.json</span> in the config volume so that they can be looked up here.</p>
        <div class="flash-info">Run the <span class="code">composer config http-basic...</span> command inside the project: it writes <span class="code">auth.json</span> next to composer.json, keep that file out of git. With <span class="code">--global</span> the credentials go to the Composer home of the user instead, which containers such as ddev lose on restart.</div>
        {% if users is empty %}
            <p class="text-sm text-danger">No users yet, nobody can download packages.</p>
        {% else %}
            <table class="table">
                <thead><tr><th>User</th><th>Password</th><th></th></tr></thead>
                {% for user in users %}
                <tbody data-user-row class="border-t border-line">
                    <tr>
                        <td class="font-mono whitespace-nowrap">{{ user.name }}</td>
                        <td>
                            {% if user.password is not null %}
                                <div class="flex items-center gap-2">
                                    <code class="code-box" data-secret="{{ user.password }}">••••••••</code>
                                    <button type="button" class="btn-secondary btn-sm" data-reveal>Show</button>
                                    <button type="button" class="btn-secondary btn-sm" data-copy data-copy-value="{{ user.password }}">Copy</button>
                                </div>
                            {% else %}
                                <span class="text-xs text-fg-muted">not stored, set a new password to see it here</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="flex justify-end gap-2 whitespace-nowrap">
                                <button type="button" class="btn-secondary btn-sm" data-change-user="{{ user.name }}">Change password</button>
                                <form method="post" action="{{ path('app_user_delete', {username: user.name}) }}" data-confirm="Remove user {{ user.name }}?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.name) }}">
                                    <button type="submit" class="btn-danger btn-sm">Remove</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% if user.password is not null %}
                    <tr>
                        <td colspan="3" class="pt-0 pb-3">
                            <div class="flex items-center gap-2">
                                <code class="code-box flex-1 overflow-x-auto whitespace-nowrap" data-secret="composer config http-basic.{{ host }} {{ user.name }} {{ user.password }}">composer config http-basic.{{ host }} {{ user.name }} ••••••••</code>
                                <button type="button" class="btn-secondary btn-sm shrink-0" data-copy data-copy-value="composer config http-basic.{{ host }} {{ user.name }} {{ user.password }}">Copy</button>
                            </div>
                        </td>
                    </tr>
                    {% endif %}
                </tbody>
                {% endfor %}
            </table>
        {% endif %}
    </div>
    <div class="card">
        <h2 class="mb-4 text-base font-semibold" data-user-form-title>Add user</h2>
        {{ form_start(form, {attr: {'data-user-form': ''}}) }}
            {{ form_row(form.username) }}
            <div class="mb-4">
                {{ form_label(form.password) }}
                <div class="flex gap-2">
                    {{ form_widget(form.password, {attr: {'data-secret-input': ''}}) }}
                    <button type="button" class="btn-secondary shrink-0" data-generate-secret data-secret-length="16">Generate</button>
                </div>
                {{ form_help(form.password) }}
                {{ form_errors(form.password) }}
            </div>
            <button type="submit" class="btn-primary" data-user-form-submit>Save</button>
        {{ form_end(form) }}
    </div>
</div>

<h2 id="tokens" class="mb-4 mt-10 text-xl font-semibold">Access tokens</h2>
<div class="grid gap-6 lg:grid-cols-3">
    <div class="card lg:col-span-2">
        <p class="mb-4 text-sm text-fg-muted">Tokens work like users without a name: Composer sends them as <span class="code">Authorization: Bearer</span>. Handy for CI pipelines and when you prefer one token per machine. Stored in <span class="code">tokens.json</span> in the config volume.</p>
        <div class="flash-info">Store a token in the project with <span class="code">composer config bearer.{{ host }} &lt;token&gt;</span> (writes <span class="code">auth.json</span>, keep it out of git) or with <span class="code">--global</span> for the whole machine.</div>
        {% if tokens is empty %}
            <p class="text-sm text-fg-muted">No tokens yet.</p>
        {% else %}
            <table class="table">
                <thead><tr><th>Name</th><th>Token</th><th>Created</th><th>Last used</th><th></th></tr></thead>
                {% for token in tokens %}
                <tbody data-user-row class="border-t border-line">
                    <tr>
                        <td class="whitespace-nowrap">{{ token.name }}</td>
                        <td>
                            <div class="flex items-center gap-2">
                                <code class="code-box" data-secret="{{ token.token }}">{{ token.token|slice(0, 10) }}••••</code>
                                <button type="button" class="btn-secondary btn-sm" data-reveal>Show</button>
                                <button type="button" class="btn-secondary btn-sm" data-copy data-copy-value="{{ token.token }}">Copy</button>
                            </div>
                        </td>
                        <td class="whitespace-nowrap text-xs text-fg-muted">{{ token.created_at ? token.created_at|date('Y-m-d H:i') : '' }}</td>
                        <td class="whitespace-nowrap text-xs text-fg-muted">{{ token.last_used_at ? token.last_used_at|date('Y-m-d H:i') : 'never' }}</td>
                        <td>
                            <form method="post" action="{{ path('app_token_delete', {id: token.id}) }}" class="flex justify-end" data-confirm="Remove token {{ token.name }}?">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-token-' ~ token.id) }}">
                                <button type="submit" class="btn-danger btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="5" class="pt-0 pb-3">
                            <div class="flex items-center gap-2">
                                <code class="code-box flex-1 overflow-x-auto whitespace-nowrap" data-secret="composer config bearer.{{ host }} {{ token.token }}">composer config bearer.{{ host }} {{ token.token|slice(0, 10) }}••••</code>
                                <button type="button" class="btn-secondary btn-sm shrink-0" data-copy data-copy-value="composer config bearer.{{ host }} {{ token.token }}">Copy</button>
                            </div>
                        </td>
                    </tr>
                </tbody>
                {% endfor %}
            </table>
        {% endif %}
    </div>
    <div class="card">
        <h2 class="mb-4 text-base font-semibold">Create token</h2>
        {{ form_start(token_form) }}
            {{ form_widget(token_form) }}
            <button type="submit" class="btn-primary">Generate token</button>
        {{ form_end(token_form) }}
    </div>
</div>

<h2 id="ips" class="mt-10 mb-4 text-lg font-semibold">IP allow list</h2>
<div class="grid gap-6 lg:grid-cols-3">
    <div class="card lg:col-span-2">
        <p class="mb-4 text-sm text-fg-muted">Requests from these addresses get <span class="code">packages.json</span>, the metadata and the dist archives without any credentials, for example from an office network or fixed CI runners. Everyone else still needs a user or token. nginx checks the client address behind the proxy (<span class="code">X-Forwarded-For</span> from <span class="code">TRUSTED_PROXIES</span>); your current address is <span class="code">{{ client_ip ?? 'unknown' }}</span>.</p>
        {% if ips is empty %}
            <p class="text-sm text-fg-muted">No addresses on the list.</p>
        {% else %}
            <table class="table">
                <thead><tr><th>Address</th><th>Label</th><th>Added</th><th></th></tr></thead>
                <tbody>
                {% for entry in ips %}
                    <tr class="border-t border-line">
                        <td class="font-mono whitespace-nowrap">{{ entry.ip }}</td>
                        <td>{{ entry.label }}</td>
                        <td class="whitespace-nowrap text-xs text-fg-muted">{{ entry.created_at ? entry.created_at|date('Y-m-d H:i') : '' }}</td>
                        <td>
                            <form method="post" action="{{ path('app_ip_delete', {id: entry.id}) }}" class="flex justify-end" data-confirm="Remove {{ entry.ip }} from the allow list?">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-ip-' ~ entry.id) }}">
                                <button type="submit" class="btn-danger btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
    <div class="card">
        <h2 class="mb-4 text-base font-semibold">Allow address</h2>
        {{ form_start(ip_form) }}
            {{ form_widget(ip_form) }}
            <button type="submit" class="btn-primary">Add to allow list</button>
        {{ form_end(ip_form) }}
    </div>
</div>
{% endblock %}
