{% extends 'base.html.twig' %}

{% block title %}Sign in · {{ app_name }}{% endblock %}

{% block body %}
<div class="relative flex min-h-full items-center justify-center px-4">
    <button type="button" class="theme-toggle absolute right-4 top-4" data-theme-toggle title="Switch theme"><span data-theme-icon>☀️</span><span data-theme-label>System</span></button>
    <div class="w-full max-w-sm">
        <div class="mb-6 text-center text-2xl font-semibold text-fg">📦 {{ app_name }}</div>
        <form method="post" class="card">
            {% if error %}
                <div class="flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            {% if password_missing %}
                <div class="flash-warning">ADMIN_PASSWORD is not set, login is disabled.</div>
            {% endif %}
            <div class="mb-4">
                <label for="username" class="label">User name</label>
                <input type="text" id="username" name="_username" value="{{ last_username }}" class="input" required autofocus autocomplete="username">
            </div>
            <div class="mb-6">
                <label for="password" class="label">Password</label>
                <input type="password" id="password" name="_password" class="input" required autocomplete="current-password">
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="btn-primary w-full">Sign in</button>
        </form>
    </div>
</div>
{% endblock %}
