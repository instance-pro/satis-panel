{% extends 'layout.html.twig' %}

{% block title %}Edit repository · {{ app_name }}{% endblock %}
{% block heading %}Edit repository{% endblock %}
{% block actions %}<a href="{{ path('app_repositories') }}" class="btn-secondary btn-sm">Back</a>{% endblock %}

{% block content %}
<div class="card max-w-2xl">
    {{ form_start(form) }}
        {{ form_row(form.type) }}
        {{ form_row(form.url) }}
        {{ form_row(form.name) }}
        {{ form_row(form.noApi) }}
        <div class="mb-4">
            {{ form_label(form.webhookSecret) }}
            <div class="flex gap-2">
                {{ form_widget(form.webhookSecret) }}
                <button type="button" class="btn-secondary shrink-0" data-generate-secret>Generate</button>
            </div>
            {{ form_help(form.webhookSecret) }}
            {{ form_errors(form.webhookSecret) }}
        </div>
        <div class="flex gap-2">
            <button type="submit" class="btn-primary">Save</button>
            <a href="{{ path('app_repositories') }}" class="btn-secondary">Cancel</a>
        </div>
    {{ form_end(form) }}
    {% set extra = repository|filter((v, k) => k not in ['type', 'url', 'name', 'no-api']) %}
    {% if extra is not empty %}
        <p class="mt-6 text-xs text-fg-muted">Additional keys in satis.json are kept as they are:</p>
        <pre class="pre mt-2">{{ extra|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) }}</pre>
    {% endif %}
</div>
{% endblock %}
