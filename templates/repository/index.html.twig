{% extends 'layout.html.twig' %}

{% block title %}Repositories · {{ app_name }}{% endblock %}
{% block heading %}Repositories{% endblock %}

{% block content %}
<div class="grid gap-6 lg:grid-cols-3">
    <div class="card lg:col-span-2">
        {% if repositories is empty %}
            <p class="text-sm text-fg-muted">No repositories yet. Add the first one on the right.</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="table">
                    <thead><tr><th>Type</th><th>URL</th><th>Name</th><th></th></tr></thead>
                    <tbody class="divide-y divide-line">
                    {% for index, repository in repositories %}
                        <tr>
                            <td><span class="badge-slate">{{ repository.type|default('?') }}</span>{% if repository['no-api']|default(false) %} <span class="badge-slate">no-api</span>{% endif %}{% if signed[index]|default(false) %} <span class="badge-green" title="Webhook requests must be signed">signed</span>{% endif %}</td>
                            <td class="break-all font-mono text-xs">{{ repository.url|default('') }}</td>
                            <td>{{ repository.name|default('') }}</td>
                            <td>
                                <div class="flex justify-end gap-2 whitespace-nowrap">
                                    <a href="{{ path('app_repository_edit', {index: index}) }}" class="btn-secondary btn-sm">Edit</a>
                                    <form method="post" action="{{ path('app_repository_delete', {index: index}) }}" data-confirm="Remove {{ repository.url|default('this repository') }} from satis.json?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-repository-' ~ index) }}">
                                        <button type="submit" class="btn-danger btn-sm">Remove</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
    <div class="card">
        <h2 class="mb-4 text-base font-semibold">Add repository</h2>
        {{ form_start(form) }}
            {{ form_row(form.type) }}
            {{ form_row(form.url) }}
            {{ form_row(form.name) }}
            {{ form_row(form.noApi) }}
            <div class="mb-4">
                {{ form_label(form.webhookSecret) }}
                <div class="flex gap-2">
                    {{ form_widget(form.webhookSecret) }}
                    <button type="button" class="btn-secondary shrink-0" data-generate-secret>Generate</button>
                </div>
                {{ form_help(form.webhookSecret) }}
                {{ form_errors(form.webhookSecret) }}
            </div>
            <button type="submit" class="btn-primary">Add</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
