{% extends 'base.html.twig' %}

{% block body %}
{% set current = app.current_route %}
{% set nav = [
    {route: 'app_dashboard', label: 'Dashboard', match: ['app_dashboard']},
    {route: 'app_repositories', label: 'Repositories', match: ['app_repositories', 'app_repository_edit']},
    {route: 'app_configuration', label: 'Configuration', match: ['app_configuration']},
    {route: 'app_build', label: 'Build', match: ['app_build']},
    {route: 'app_users', label: 'Composer users', match: ['app_users']},
    {route: 'app_ssh', label: 'SSH', match: ['app_ssh']},
] %}
<div class="flex min-h-full">
    <aside class="hidden w-60 shrink-0 flex-col border-r border-line bg-canvas-subtle md:flex">
        <div class="flex h-16 items-center gap-2 px-5 text-lg font-semibold text-fg">
            <span>📦</span> {{ app_name }}
        </div>
        <nav class="flex-1 space-y-1 px-3">
            {% for item in nav %}
                <a href="{{ path(item.route) }}" class="nav-link {{ current in item.match ? 'nav-link-active' }}">{{ item.label }}</a>
            {% endfor %}
        </nav>
        <div class="border-t border-line px-5 py-4 text-xs text-fg-muted">
            Signed in as <span class="text-fg">{{ app.user ? app.user.userIdentifier : '' }}</span>
            <div class="mt-3 flex items-center justify-between gap-2">
                <form method="post" action="{{ path('app_logout') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="text-fg-muted hover:text-fg">Sign out</button>
                </form>
                <button type="button" class="theme-toggle" data-theme-toggle title="Switch theme"><span data-theme-icon>☀️</span><span data-theme-label>System</span></button>
            </div>
        </div>
    </aside>
    <div class="flex min-w-0 flex-1 flex-col">
        <header class="flex h-16 items-center justify-between border-b border-line bg-canvas-subtle px-6 md:hidden">
            <span class="font-semibold">📦 {{ app_name }}</span>
            <nav class="flex items-center gap-3 text-sm">
                {% for item in nav %}
                    <a href="{{ path(item.route) }}" class="{{ current in item.match ? 'text-accent font-medium' : 'text-fg-muted' }}">{{ item.label }}</a>
                {% endfor %}
                <button type="button" class="theme-toggle" data-theme-toggle title="Switch theme"><span data-theme-icon>☀️</span></button>
            </nav>
        </header>
        <main class="flex-1 px-6 py-8">
            <div class="mx-auto max-w-5xl">
                <div class="mb-6 flex items-center justify-between">
                    <h1 class="text-2xl font-semibold">{% block heading %}{% endblock %}</h1>
                    <div>{% block actions %}{% endblock %}</div>
                </div>
                {% include '_flashes.html.twig' %}
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>
</div>
{% endblock %}
