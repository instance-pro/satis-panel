{% extends 'layout.html.twig' %}

{% block title %}Source access · {{ app_name }}{% endblock %}
{% block heading %}Source access{% endblock %}

{% block content %}
<div class="grid gap-6 lg:grid-cols-2">
    <div class="card lg:col-span-2">
        <h2 class="mb-2 text-base font-semibold">Deploy key</h2>
        {% if has_key %}
            <p class="mb-3 text-sm text-fg-muted">Add this public key as a read-only deploy key (Bitbucket: access key, GitHub: deploy key, GitLab: deploy key) to every private repository, or to a machine user.</p>
            <pre class="pre select-all">{{ public_key }}</pre>
            <p class="mt-2 text-xs text-fg-muted">{{ fingerprint }} · private key: <span class="code">{{ key_path }}</span></p>
            <form method="post" action="{{ path('app_ssh_delete') }}" class="mt-4" data-confirm="Delete the SSH key? Repositories using it will stop building.">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-ssh-key') }}">
                <button type="submit" class="btn-danger btn-sm">Delete key</button>
            </form>
        {% else %}
            <p class="text-sm text-fg-muted">No SSH key yet. Generate one below or import an existing private key.</p>
        {% endif %}
    </div>

    <div class="card">
        <h2 class="mb-4 text-base font-semibold">{{ has_key ? 'Replace with a new key' : 'Generate key' }}</h2>
        {{ form_start(generate_form, {attr: has_key ? {'data-confirm': 'Generate a new key? The current key is replaced.'} : {}}) }}
            {{ form_widget(generate_form) }}
            <button type="submit" class="btn-primary">Generate</button>
        {{ form_end(generate_form) }}
    </div>

    <div class="card">
        <h2 class="mb-4 text-base font-semibold">Import private key</h2>
        {{ form_start(import_form, {attr: has_key ? {'data-confirm': 'Import this key? The current key is replaced.'} : {}}) }}
            {{ form_widget(import_form) }}
            <button type="submit" class="btn-primary">Import</button>
        {{ form_end(import_form) }}
    </div>

    <div class="card lg:col-span-2">
        <h2 class="mb-2 text-base font-semibold">Known hosts</h2>
        <p class="mb-4 text-sm text-fg-muted">github.com, gitlab.com and bitbucket.org are trusted by default. Add self-hosted git servers here, otherwise SSH refuses to connect. Stored in <span class="code">{{ known_hosts_path }}</span>.</p>
        <div class="grid gap-6 md:grid-cols-2">
            <div>
                {% if known_hosts is empty %}
                    <p class="text-sm text-fg-muted">No additional hosts.</p>
                {% else %}
                    <table class="table">
                        <thead><tr><th>Host</th><th>Key type</th><th></th></tr></thead>
                        <tbody class="divide-y divide-line">
                        {% for entry in known_hosts %}
                            <tr>
                                <td class="font-mono text-xs">{{ entry.host }}</td>
                                <td class="text-xs">{{ entry.type }}</td>
                                <td>
                                    {% if entry.host != '(hashed entry)' %}
                                    <form method="post" action="{{ path('app_ssh_known_host_delete') }}" class="flex justify-end">
                                        <input type="hidden" name="host" value="{{ entry.host }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-known-host-' ~ entry.host) }}">
                                        <button type="submit" class="btn-danger btn-sm">Remove</button>
                                    </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
            <div>
                {{ form_start(known_host_form) }}
                    <div class="grid gap-x-4 sm:grid-cols-3">
                        <div class="sm:col-span-2">{{ form_row(known_host_form.host) }}</div>
                        <div>{{ form_row(known_host_form.port) }}</div>
                    </div>
                    <button type="submit" class="btn-secondary">Scan host key</button>
                {{ form_end(known_host_form) }}
            </div>
        </div>
    </div>
</div>

<h2 id="composer-auth" class="mb-4 mt-10 text-xl font-semibold">HTTPS sources (Composer authentication)</h2>
<div class="grid gap-6 lg:grid-cols-2">
    <div class="card">
        <p class="mb-4 text-sm text-fg-muted">Credentials satis uses for private repositories reached over HTTPS: GitHub, GitLab and Bitbucket tokens or basic auth for other Composer repositories. Stored in <span class="code">{{ composer_auth_path }}</span> (Composer's <span class="code">auth.json</span>). Repositories reached over SSH use the deploy key above instead.</p>
        {% if composer_auth_env %}
            <div class="flash-info">The <span class="code">COMPOSER_AUTH</span> environment variable is set as well; Composer merges it over the entries below.</div>
        {% endif %}
        {% if composer_auth is empty %}
            <p class="text-sm text-fg-muted">No entries yet.</p>
        {% else %}
            <table class="table">
                <thead><tr><th>Type</th><th>Host</th><th>Credentials</th><th></th></tr></thead>
                {% for entry in composer_auth %}
                <tbody data-user-row class="border-t border-line">
                    <tr>
                        <td><span class="badge-slate">{{ entry.type }}</span></td>
                        <td class="font-mono text-xs">{{ entry.host }}</td>
                        <td>
                            <div class="flex items-center gap-2">
                                {% if entry.summary %}<span class="font-mono text-xs">{{ entry.summary }}</span>{% endif %}
                                <code class="code-box" data-secret="{{ entry.secret }}">••••••••</code>
                                <button type="button" class="btn-secondary btn-sm" data-reveal>Show</button>
                                <button type="button" class="btn-secondary btn-sm" data-copy data-copy-value="{{ entry.secret }}">Copy</button>
                            </div>
                        </td>
                        <td>
                            <form method="post" action="{{ path('app_composer_auth_delete') }}" class="flex justify-end" data-confirm="Remove the credentials for {{ entry.host }}?">
                                <input type="hidden" name="type" value="{{ entry.type }}">
                                <input type="hidden" name="host" value="{{ entry.host }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-composer-auth-' ~ entry.type ~ '-' ~ entry.host) }}">
                                <button type="submit" class="btn-danger btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                </tbody>
                {% endfor %}
            </table>
        {% endif %}
    </div>
    <div class="card">
        <h2 class="mb-4 text-base font-semibold">Add or update credentials</h2>
        {{ form_start(composer_auth_form, {attr: {'data-composer-auth-form': ''}}) }}
            {{ form_row(composer_auth_form.type) }}
            {{ form_row(composer_auth_form.host) }}
            <div data-auth-username>{{ form_row(composer_auth_form.username) }}</div>
            {{ form_row(composer_auth_form.secret) }}
            <button type="submit" class="btn-primary">Save</button>
        {{ form_end(composer_auth_form) }}
        <p class="mt-3 text-xs text-fg-muted">Saving an existing type and host replaces the entry. The same layout as in Composer's auth.json, so anything Composer documents works here.</p>
    </div>
</div>
{% endblock %}
