#!/bin/bash
# Runs php-fpm and nginx side by side; the container stops when either exits.
set -e

php-fpm &
FPM_PID=$!
nginx -g 'daemon off;' &
NGINX_PID=$!

# Build queue worker (only with Redis). Restarted automatically when it exits.
WORKER_PID=""
if [ -n "$REDIS_URL" ]; then
    runuser -u www-data -- bash -c 'cd /var/www/html; while true; do php bin/console app:build:worker --no-interaction --no-ansi; echo "satis-panel-serve: build worker exited, restarting in 3s"; sleep 3; done' &
    WORKER_PID=$!
fi

# Reload nginx when the IP allow list changes (written by the app as www-data,
# which cannot signal nginx itself).
IP_ALLOW_FILE="$(dirname "$SATIS_HTPASSWD_FILE")/ip-allow-list.conf"
(
    last=$(stat -c "%i %Y %s" "$IP_ALLOW_FILE" 2>/dev/null || echo 0)
    while true; do
        sleep 2
        now=$(stat -c "%i %Y %s" "$IP_ALLOW_FILE" 2>/dev/null || echo 0)
        if [ "$now" != "$last" ]; then
            last=$now
            if nginx -t -q 2>/dev/null; then
                nginx -s reload && echo "satis-panel-serve: IP allow list changed, nginx reloaded"
            else
                echo "satis-panel-serve: WARNING: nginx configuration invalid after allow list change, not reloaded"
                nginx -t 2>&1 | head -3
            fi
        fi
    done
) &
WATCH_PID=$!

shutdown() {
    kill -TERM "$WATCH_PID" 2>/dev/null || true
    if [ -n "$WORKER_PID" ]; then
        pkill -TERM -P "$WORKER_PID" 2>/dev/null || true
        kill -TERM "$WORKER_PID" 2>/dev/null || true
    fi
    kill -TERM "$FPM_PID" "$NGINX_PID" 2>/dev/null || true
    wait "$FPM_PID" "$NGINX_PID" 2>/dev/null || true
}
trap shutdown TERM INT

wait -n "$FPM_PID" "$NGINX_PID"
STATUS=$?
echo "satis-panel-serve: a service exited with status $STATUS, shutting down"
shutdown
exit "$STATUS"
